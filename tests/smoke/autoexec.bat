@ECHO OFF
ECHO GRDOS-TEST-BEGIN>AUX
VER>AUX
DIR>AUX
ECHO hello>HELLO.TXT
COPY HELLO.TXT HELLO2.TXT>AUX
TYPE HELLO2.TXT>AUX
DEL HELLO.TXT
IF NOT EXIST HELLO.TXT ECHO GRDOS-DEL-OK>AUX
MD SUB
IF EXIST SUB\NUL ECHO GRDOS-MD-OK>AUX
HELLO>AUX
IF ERRORLEVEL 7 IF NOT ERRORLEVEL 8 ECHO GRDOS-ERRORLEVEL-7>AUX
ECHO EXIT>EXIT.TXT
COMMAND <EXIT.TXT >AUX
ECHO GRDOS-TEST-END>AUX
