+void Masm5PassInit( void )
+/************************/
+{
+    if ( Parse_Pass == PASS_1 )
+        Masm5Count = 0;
+    Masm5Index = 0;
+}
+
+void Masm5Pad( enum instr_token token, uint_32 size )
+/***************************************************/
+{
+    if ( Parse_Pass == PASS_1 ) {
+        if ( Masm5Count == Masm5Max ) {
+            Masm5Max = Masm5Max ? Masm5Max * 2 : 1024;
+            Masm5Sizes = realloc( Masm5Sizes, Masm5Max * sizeof( *Masm5Sizes ) );
+            if ( Masm5Sizes == NULL )
+                Fatal( OUT_OF_MEMORY );
+        }
+        Masm5Sizes[Masm5Count].token = token;
+        Masm5Sizes[Masm5Count].dispmask = Masm5DispMask;
+        Masm5Sizes[Masm5Count].size = size;
+        Masm5Count++;
+        return;
+    }
+    if ( Masm5Index >= Masm5Count || Masm5Sizes[Masm5Index].token != token ) {
+        /* the instruction sequence differs from pass one */
+        Masm5Index = Masm5Count;
+        return;
+    }
+    for ( ; size < Masm5Sizes[Masm5Index].size; size++ )
+        OutputByte( 0x90 );
+    Masm5Index++;
+}
