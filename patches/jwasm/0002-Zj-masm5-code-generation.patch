+/* -Zj: MASM 5 sizing. MASM 5 fixes each instruction's size in pass one,
+ * where a forward reference is assumed to be a near label or a word
+ * variable, and pads the instruction with NOPs in pass two if it turns out
+ * shorter. A forward reference in a displacement keeps its 16-bit size.
+ * The pass one size of each instruction is recorded here, indexed by its
+ * position in the source, and later passes pad up to it.
+ */
+
+static struct {
+    enum instr_token token;
+    uint_8  dispmask;   /* operands with a 16-bit displacement */
+    uint_32 size;
+} *Masm5Sizes;
+static unsigned Masm5Count;
+static unsigned Masm5Max;
+static unsigned Masm5Index;
+bool Masm5FwdRef;              /* expression had a forward reference */
+static uint_8 Masm5OpndFwd;    /* operands with forward references */
+static uint_8 Masm5DispMask;   /* operands with a forced 16-bit displacement */
+
+/* -Zj: instructions of the 80/83 group */
+#define IS_ARITH( t ) ( t == T_ADD || t == T_OR || t == T_ADC || t == T_SBB || \
+                        t == T_AND || t == T_SUB || t == T_XOR || t == T_CMP )
+
 #define EPCOMMENTS 0 /* 1=add pure comment lines to -EP output */
 
 #define ADDRSIZE( s, x ) ( ( ( x ) ^ ( s ) ) ? TRUE : FALSE )
