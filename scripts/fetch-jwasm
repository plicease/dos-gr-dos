#!/bin/sh
#
# Fetch and build the pinned JWasm (decision 19) with the patches in
# patches/jwasm applied. Prints the path of the jwasm executable on stdout.
# Reuses an existing build of the same patch set.
#
# usage: scripts/fetch-jwasm [DESTDIR]     (default: build/tools)

set -eu

version=v2.20
commit=ac54827ff40b77ecd6e77ed0866a43fc60cd5fe1
repo=https://github.com/Baron-von-Riedesel/JWasm.git

root=$(cd "$(dirname "$0")/.." && pwd)
dest=${1:-"$root/build/tools"}
patches=$(cat "$root"/patches/jwasm/*.patch | sha256sum | cut -c1-12)
dir="$dest/jwasm-$version-$patches"
jwasm="$dir/build/GccUnixR/jwasm"

if [ ! -x "$jwasm" ]; then
  rm -rf "$dir"
  mkdir -p "$dir"
  git -C "$dir" init -q
  git -C "$dir" fetch -q --depth 1 "$repo" "$commit"
  git -C "$dir" checkout -q FETCH_HEAD
  [ "$(git -C "$dir" rev-parse HEAD)" = "$commit" ]
  for p in "$root"/patches/jwasm/*.patch; do
    git -C "$dir" apply "$p"
  done
  make -s -C "$dir" -f GccUnix.mak > "$dir/build.log" 2>&1 \
    || { cat "$dir/build.log" >&2; exit 1; }
fi

echo "$jwasm"
